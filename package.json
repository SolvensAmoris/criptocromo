{
  "name": "criptocromo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "factorial": "tsx src/experiments/at001/factorial.ts",
    "at002:plan": "tsx src/experiments/at002-calibration/plan.ts",
    "at002:cal01": "tsx src/experiments/at002-calibration/cal01.ts",
    "at002:cal02": "tsx src/experiments/at002-calibration/cal02.ts",
    "netlogo:export": "tsx src/experiments/netlogo-interop.ts export",
    "netlogo:compare": "tsx src/experiments/netlogo-interop.ts compare",
    "verify:definitions": "node scripts/definition-comparator.mjs",
    "test:definitions": "node --test scripts/topology-audit.test.mjs",
    "test:behavioral-equivalence": "node --test scripts/behavioral-equivalence-evaluator.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.12"
  }
}
